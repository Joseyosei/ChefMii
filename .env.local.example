# ============================================================
# ChefMii - Environment Variables Example
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ─── Firebase Client ──────────────────────────────────────────
# Found in: Firebase Console > Project Settings > General > Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GCP_PROJECT_ID=project-c5daea85-d002-4d77-a3f
GCP_PROJECT_NUMBER=193892859007

# ─── Firebase Admin ───────────────────────────────────────────
# Base64 encoded JSON of your Firebase service account key
# Generate via: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Encode on Mac/Linux with: base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Stripe ─────────────────────────────────────────────────
# Found in: Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHEF_BOOKING_FEE_PRICE_ID=
STRIPE_PLATFORM_FEE_PERCENT=10

# ─── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChefMii

# ─── AI / Gemini ─────────────────────────────────────────────
# Found in: Google AI Studio > Get API key
GEMINI_API_KEY=

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@chefmii.com

# ─── External Maps (for chef location display) ───────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
